DATABASE_URL="postgresql://postgres:password@localhost:5432/unnati_charitable"

# Get SEPARATE keys for sandbox and production from Cashfree dashboard:
# https://merchant.cashfree.com/merchants/pg/test-and-live
CASHFREE_APP_ID="your_sandbox_app_id"
CASHFREE_SECRET_KEY="your_sandbox_secret_key"

# Must match your keys:
#   sandbox    -> sandbox keys  + http://localhost URLs are OK
#   production -> live keys     + https URLs required (ngrok or deployed site)
CASHFREE_ENV=production

# Optional. If omitted, URL is chosen automatically from CASHFREE_ENV.
CASHFREE_BASE_URL="https://api.cashfree.com/pg"

# Local development (sandbox):
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# Production / ngrok example (only needed with live keys):
# FRONTEND_URL="https://your-frontend.ngrok-free.app"
# BACKEND_URL="https://your-backend.ngrok-free.app"

PORT=5000

# Required to use GET /api/logs — protects the log-viewing endpoint.
# Generate one with: node -e "console.log(require('crypto').randomUUID())"
LOG_ACCESS_TOKEN="set-a-long-random-secret-here"

# Email — donation certificate PDF after successful payment
#
# WHY EMAILS GO TO SPAM WITH GMAIL:
# Sending from Render/cloud via personal Gmail often lands in spam because:
#   - Org name "Unnati Charitable Trust" + @gmail.com looks like spoofing
#   - PDF attachments from unknown senders trigger filters
#   - Datacenter IPs + Gmail SMTP = poor reputation
#
# RECOMMENDED (free, better inbox delivery): Brevo — https://www.brevo.com
#   1. Sign up → Settings → SMTP & API → create SMTP key
#   2. Senders → verify your email (or add your domain for best results)
#   3. Use these settings:
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email@example.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM_EMAIL=your-verified-sender@example.com
# SMTP_FROM_NAME=Unnati Charitable Trust
# REPLY_TO_EMAIL=your-verified-sender@example.com
#
# GMAIL (local testing only — not recommended for production):
# IMPORTANT: SMTP_FROM_EMAIL must match SMTP_USER exactly.
# Gmail: enable 2FA → App passwords (spaces OK, stripped automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Unnati Charitable Trust
REPLY_TO_EMAIL=your-email@gmail.com
